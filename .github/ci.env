# Credenciais falsas de serviços de terceiros, compartilhadas pelos jobs do
# PR gate (`test` e `build`).
#
# Existe como arquivo — e não inline no workflow — porque duas listas destas
# lado a lado dessincronizam: o job `test` roda o pytest e o job `build` sobe
# a imagem real, e os dois precisam do mesmo conjunto. Foi exatamente o modo
# de falha do `COVERAGE_MINIMUM`, documentado no cabeçalho do workflow.
#
# Formato `KEY=VALUE` sem aspas, de propósito: é consumido tanto por
# `docker run --env-file` quanto por `>> "$GITHUB_ENV"`, e os dois tratam
# aspas como parte literal do valor.
#
# NÃO entram aqui, por serem específicas de cada job:
#
#   REDIS_URL, MONGODB_URL  o job `test` alcança os services do runner em
#                           localhost; de dentro do container, localhost é o
#                           próprio container.
#   DATA_DIR                `/tmp` basta para o pytest; o container precisa
#                           de `/app/data`, onde ficam bairros.json e
#                           logradouros.json.
#   GCP_SERVICE_ACCOUNT_CREDENTIALS
#                           o pytest sobrescreve o valor via conftest e aceita
#                           qualquer placeholder; o container roda o preflight
#                           de verdade, que rejeita qualquer coisa que não
#                           seja uma service account parseável.
#
# Nenhum valor aqui é segredo: todos apontam para hosts `.local` inexistentes.

VALID_TOKENS=test-token
WORKFLOWS_GCP_SERVICE_ACCOUNT=test-workflows-sa
WORKFLOWS_GCS_BUCKET=test-workflows-bucket
GEMINI_API_KEY=test-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_MAPS_API_KEY=test-google-key
SHORT_API_URL=https://test.short.local
SHORT_API_TOKEN=test-short-token
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
ERROR_INTERCEPTOR_URL=https://test.interceptor.local/api
ERROR_INTERCEPTOR_TOKEN=test-interceptor-token
IPTU_API_URL=https://test.iptu.local/api
IPTU_API_TOKEN=test-iptu-token
WA_IPTU_URL=https://test.wa-iptu.local/api
WA_IPTU_TOKEN=test-wa-iptu-token
WA_IPTU_PUBLIC_KEY=test-wa-iptu-public-key
DIVIDA_ATIVA_API_URL=https://test.divida.local/api
DIVIDA_ATIVA_ACCESS_KEY=test-divida-access-key
REDIS_TTL_SECONDS=3600
PROXY_URL=https://test.proxy.local
SGRC_URL=https://test.sgrc.local/api
SGRC_AUTHORIZATION_HEADER=test-sgrc-auth
SGRC_BODY_TOKEN=test-sgrc-body-token
GMAPS_API_TOKEN=test-gmaps-token
TYPESENSE_PARAMETERS=none
